{
  "manifest_version": 3,
  "name": "Roundtable Companion",
  "version": "0.1.0",
  "description": "Explicitly share a selected page with your local-only Roundtable session.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Share a page with Roundtable",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
