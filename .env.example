# Set variables in your own shell. Roundtable does not automatically load .env.
# Never commit actual credentials. Default data directory: ~/.roundtable.
# ROUNDTABLE_HOME=C:/path/to/private/roundtable-data
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# LOCAL_API_KEY=local-server-placeholder
# Optional operator-configured services; require agent permissions too.
# ROUNDTABLE_RESEARCH_URL=https://your-service.example/research
# ROUNDTABLE_RESEARCH_TOKEN=
# ROUNDTABLE_MCP_URL=https://your-service.example/mcp
# ROUNDTABLE_MCP_TOKEN=
# ROUNDTABLE_MCP_TOOLS=["approved_tool_name"]
# Preinstall a trusted image. Prefer an immutable image digest.
# ROUNDTABLE_CONTAINER_IMAGE=node:24-alpine
